# HILAARA Store - Environment Variables Example
# Copy this file to .env for local development

# Supabase Configuration (Client & Backend)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# ImageKit Configuration (Client CDN & Uploads)
VITE_IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your-id
VITE_IMAGEKIT_PUBLIC_KEY=your-imagekit-public-key

# Serverless Functions Runtime Only (Never expose to client bundle)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
IMAGEKIT_PRIVATE_KEY=your-imagekit-private-key
